[Unit]
Description=Fluxer Meilisearch

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false
EnvironmentFile=%h/Fluxer/.meilienv
TimeoutSec=10m
TimeoutStopSec=10m

[Container]
Image=docker.io/getmeili/meilisearch:v1.56.1
ContainerName=fluxer-meilisearch
StopTimeout=9999
Environment=TINI_SUBREAPER=1
Environment=MEILI_ENV=production
Environment=MEILI_NO_ANALYTICS=true
Environment=MEILI_MAX_INDEXING_MEMORY=256M
Environment=MEILI_MAX_INDEXING_THREADS=1
Environment=MEILI_MASTER_KEY=${MASTER_KEY}
Environment=MEILI_UPGRADE_DB=true
Volume=/srv/fluxer/meili:/meili_data:U,Z
HealthCmd=curl -X GET 'http://127.0.0.1:7700/health' -H 'Authorization: Bearer $${MASTER_KEY}'
HealthInterval=5s
HealthRetries=99
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
User=1101:1101
Memory=1G
PodmanArgs=--memory-swap=0M
Pod=CORE.pod
