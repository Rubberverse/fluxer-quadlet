# Fails sometimes. Not sure why as usually it works fine.
[Unit]
Description=Fluxer SeaweedFS Bucket Initializer
Requires=flseaweedfs.service
After=flseaweedfs.service

[Service]
EnvironmentFile=%h/Fluxer/.sysenv

[Install]
WantedBy=default.target

[Container]
Image=public.ecr.aws/aikido-dev/chrislusf/seaweedfs:latest
ContainerName=fluxer-seaweedfs-init
EnvironmentFile=%h/Fluxer/.env
Entrypoint=/bin/sh
Exec=-c ' \
buckets="$FLUXER_S3_BUCKET_CDN $FLUXER_S3_BUCKET_UPLOADS $FLUXER_S3_BUCKET_REPORTS $FLUXER_S3_BUCKET_HARVESTS"; \
missing="$buckets"; \
for attempt in $(seq 1 $FLUXER_SEAWEEDFS_INIT_ATTEMPTS); do \
  if ! nc -z 127.0.0.1 9333 2>/dev/null; then \
    sleep 2; \
    continue; \
  fi; \
  listed=$(echo "s3.bucket.list" | timeout 10 weed shell -master=127.0.0.1:9333 -filer=127.0.0.1:8888 2>&1); \
  missing=""; \
  failure=""; \
  for b in $buckets; do \
    echo "$listed" | grep -q "^[[:space:]]*$b[[:space:]]" || missing="${missing:+$missing }$b"; \
  done; \
  if [ -z "$missing" ]; then \
    if [ "$FLUXER_SEAWEEDFS_UPLOADS_TTL" = off ]; then \
      ttl_rule="fs.configure -locationPrefix=/buckets/$FLUXER_S3_BUCKET_UPLOADS/ -delete -apply"; \
    else \
      ttl_rule="fs.configure -locationPrefix=/buckets/$FLUXER_S3_BUCKET_UPLOADS/ -ttl=$FLUXER_SEAWEEDFS_UPLOADS_TTL -apply"; \
    fi; \
    failure="could not configure the S3 identity"; \
    if echo "s3.configure -user=fluxer -access_key=$FLUXER_S3_ACCESS_KEY_ID -secret_key=$FLUXER_S3_SECRET_ACCESS_KEY -actions=Admin,Read,Write,List,Tagging -apply" | timeout 10 weed shell -master=127.0.0.1:9333 -filer=127.0.0.1:8888 >/dev/null 2>&1; then \
      failure="could not set the expiry of $FLUXER_S3_BUCKET_UPLOADS"; \
      if echo "$ttl_rule" | timeout 10 weed shell -master=127.0.0.1:9333 -filer=127.0.0.1:8888 >/dev/null 2>&1; then \
        echo "buckets ready"; \
        exit 0; \
      fi; \
    fi; \
    sleep 2; \
    continue; \
  fi; \
  for b in $missing; do \
    echo "s3.bucket.create -name $b" | timeout 10 weed shell -master=127.0.0.1:9333 -filer=127.0.0.1:8888 >/dev/null 2>&1; \
  done; \
  sleep 2; \
done; \
if [ -n "$failure" ]; then \
  echo "seaweedfs-init $failure" >&2; \
else \
  echo "seaweedfs-init could not verify buckets: $missing" >&2; \
fi; \
exit 1;'
ReadOnly=true
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
User=1000:1000
Pod=CORE.pod
