LOG_LEVEL=warn
RUST_LOG=warn

FLUXER_ENV=production
FLUXER_SELF_HOSTED=true

# Database - CORE.pod
FLUXER_DATABASE_BACKEND=postgres
FLUXER_POSTGRES_HOST=fluxer-core-pod
FLUXER_POSTGRES_PORT=5432
FLUXER_POSTGRES_USERNAME=
FLUXER_POSTGRES_PASSWORD=
FLUXER_POSTGRES_SSL=false
FLUXER_POSTGRES_PREPARED_STATEMENTS=true

# Valkey, S3 - CORE.pod
FLUXER_S3_ENDPOINT=http://fluxer-core-pod:8333
FLUXER_KV_URL=redis://fluxer-core-pod:6379/0
FLUXER_S3_REGION=pl-waw-1
FLUXER_S3_ACCESS_KEY_ID=$(openssl rand -hex 16)
FLUXER_S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)
FLUXER_S3_FORCE_PATH_STYLE=true
FLUXER_S3_BUCKET_CDN=fluxer
FLUXER_S3_BUCKET_UPLOADS=fluxer-uploads
FLUXER_S3_BUCKET_DOWNLOADS=fluxer-downloads
FLUXER_S3_BUCKET_REPORTS=fluxer-reports
FLUXER_S3_BUCKET_HARVESTS=fluxer-harvests
FLUXER_API_PRESIGNED_HARVEST_DOWNLOADS_ENABLED=false

# NATS + Shards/Routers - CORE.pod
FLUXER_NATS_URL=nats://fluxer-nats-pod:4222
FLUXER_NATS_JETSTREAM_URL=nats://fluxer-nats-pod:4222
FLUXER_SVC_NATS_URL=nats://fluxer-nats-pod:4222
FLUXER_SVC_SHARD_COUNT=1

# Search - CORE.pod
FLUXER_SEARCH_ENGINE=meilisearch
FLUXER_SEARCH_URL=http://fluxer-core-pod:7700
FLUXER_SEARCH_API_KEY=

# Endpoints - GENERIC.pod
FLUXER_INTERNAL_API_ENDPOINT=http://fluxer-generic-pod:8080
FLUXER_INTERNAL_GATEWAY_ENDPOINT=http://fluxer-generic-pod:7004
FLUXER_INTERNAL_MEDIA_PROXY_ENDPOINT=http://fluxer-generic-pod:7101
FLUXER_MEDIA_PROXY_ENDPOINT=http://fluxer-generic-pod:7101
