[Unit]
Description=Fluxer App Proxy
Requires=flcaddy.service
BindsTo=flcaddy.service

[Install]
WantedBy=multi-user.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=ghcr.io/fluxerapp/fluxer-app-proxy-self-hosted:v1
ContainerName=fluxer-app-proxy
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_APP_PROXY_PORT=7100
Environment=FLUXER_S3_BUCKET_UPLOADS=fluxer-uploads
Environment=FLUXER_STATIC_CDN_ENDPOINT=http://fluxer-generic-pod:7102
Environment=FLUXER_MEDIA_ENDPOINT=http://fluxer-generic-pod:7101
Environment=DISCOVERY_UPSTREAM_URL=http://fluxer-generic-pod:8088/.well-known/fluxer
Environment=PUBLIC_BOOTSTRAP_API_PUBLIC_ENDPOINT=https://chat.domain.com/api
HealthCmd=["CMD", "curl", "-fsS", "-o", "/dev/null", "http://127.0.0.1:7100/_ready"]
HealthInterval=10s
HealthRetries=30
HealthTimeout=5s
Notify=healthy
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=64M
PodmanArgs=--memory-swap=0M
Pod=FLUXER.pod
