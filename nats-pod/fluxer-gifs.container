[Unit]
Description=Fluxer Gifs Router
Requires=fluxer-nats.service
After=fluxer-nats.service
BindsTo=fluxer-nats.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=ghcr.io/fluxerapp/fluxer-gifs:v1
ContainerName=fluxer-gifs
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=gifs
Environment=FLUXER_SVC_MODE=combined
Environment=FLUXER_SVC_PORT=8095
Environment=FLUXER_GIFS_SHARD_CACHE_MAX_BYTES=134217728
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=256M
PodmanArgs=--memory-swap=0M
Pod=NATS.pod
