[Unit]
Description=Fluxer Users Router
Requires=fluxer-nats.service
After=fluxer-nats.service
BindsTo=fluxer-nats.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=ghcr.io/fluxerapp/fluxer-users:v1
ContainerName=fluxer-users
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=users
Environment=FLUXER_SVC_MODE=combined
Environment=FLUXER_SVC_PORT=8093
Environment=FLUXER_POSTGRES_MAX_CONNECTIONS=20
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=64M
PodmanArgs=--memory-swap=0M
Pod=NATS.pod
