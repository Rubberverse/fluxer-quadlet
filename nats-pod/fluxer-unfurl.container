[Unit]
Description=Fluxer Unfurl Router
Requires=fluxer-nats.service
After=fluxer-nats.service
BindsTo=fluxer-nats.service

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
SystemCallArchitectures=native
MemoryDenyWriteExecute=false

[Container]
Image=ghcr.io/fluxerapp/fluxer-unfurl:v1
ContainerName=fluxer-unfurl
EnvironmentFile=%h/Fluxer/.env
Environment=FLUXER_SVC_NAME=unfurl
Environment=FLUXER_SVC_MODE=combined
Environment=FLUXER_SVC_PORT=8094
Environment=FLUXER_MEDIA_PROXY_ENDPOINT=http://fluxer-generic-pod:7101
AutoUpdate=registry
NoNewPrivileges=true
DropCapability=all
ReadOnly=true
Memory=256M
PodmanArgs=--memory-swap=0M
Pod=NATS.pod
